@startuml LEnglish_UseCase
' ==========================================================================
'  LEnglish — Use Case Diagram (v5 — thêm "Thêm từ theo chủ đề")
'  Render: plantuml.jar (extension PlantUML - jebbs trong VS Code), Alt+D
'  Layout: smetana (không cần Graphviz).
'  LƯU Ý: KHÔNG bật 'left to right direction' — với smetana nó đẩy note/legend
'         lên toạ độ âm và bị viewBox cắt mất phần trên. Giữ bố cục top-down.
' ==========================================================================
!pragma layout smetana
skinparam dpi 150
skinparam defaultFontName "Segoe UI"
skinparam shadowing false
skinparam roundCorner 12
skinparam packageStyle rectangle
skinparam nodesep 16
skinparam ranksep 70
skinparam actorStyle awesome
skinparam actor {
  BackgroundColor #E3F2FD
  BorderColor #1565C0
  FontColor #0D47A1
  FontStyle bold
}
skinparam usecase {
  BackgroundColor #F8FBF8
  BorderColor #2E7D32
  FontColor #1B2631
  ArrowColor #607D8B
}
skinparam package {
  BackgroundColor #FAFAFA
  BorderColor #B0BEC5
  FontColor #37474F
  FontStyle bold
}
skinparam note {
  BackgroundColor #FFFDE7
  BorderColor #F9A825
}
skinparam legend {
  BackgroundColor #FAFAFA
  BorderColor #90A4AE
}

actor "Người dùng" as User
actor "AI" as AI
actor "Bộ định thời\n(hệ thống)" as Timer <<time>>

rectangle "LEnglish" {
  package "Quản lý tài khoản" {
    usecase "Tạo tài khoản" as UC_Register
    usecase "Đăng nhập" as UC_Login
    usecase "Đăng xuất" as UC_Logout
    usecase "Làm mới token" as UC_Refresh #E3F2FD
    usecase "Dọn refresh token hết hạn" as UC_CleanupToken #E3F2FD
  }
  package "Quản lý từ" {
    usecase "Xem từ" as UC_ViewWord
    usecase "Thêm từ" as UC_AddWord
    usecase "Sửa từ" as UC_EditWord
    usecase "Xóa từ" as UC_DeleteWord
    usecase "Ôn tập từ vựng" as UC_Review
    usecase "Xác nhận ôn tập" as UC_ConfirmReview
    usecase "Sinh nghĩa từ" as UC_GenMeaning #FFF8E1
    usecase "Thêm từ theo chủ đề\n(10 từ)" as UC_AddByTopic #FFF8E1
  }
  package "Quản lý đoạn văn" {
    usecase "Xem đoạn văn" as UC_ViewPhrase
    usecase "Thêm đoạn văn" as UC_AddPhrase
    usecase "Xóa đoạn văn" as UC_DeletePhrase
    usecase "Chấm đoạn văn" as UC_Grading #FFF8E1
  }
  package "Tính năng Android" {
    usecase "Thông báo ôn tập" as UC_Notify #E3F2FD
    usecase "Widget màn hình chính" as UC_Widget #E3F2FD
    usecase "Thêm từ (bôi đen)" as UC_AddFromSelection
    usecase "Quét OCR trong ảnh" as UC_ScanOCR
  }
}

' ——— Người dùng khởi tạo (mũi tên liền) ———
User --> UC_Register
User --> UC_Login
User --> UC_Logout
User --> UC_Refresh
User --> UC_ViewWord
User --> UC_AddWord
User --> UC_AddByTopic
User --> UC_EditWord
User --> UC_DeleteWord
User --> UC_Review
User --> UC_ConfirmReview
User --> UC_ViewPhrase
User --> UC_AddPhrase
User --> UC_DeletePhrase
User --> UC_AddFromSelection
User --> UC_ScanOCR

' ——— Kích hoạt theo thời gian / chạy ngầm ———
Timer --> UC_CleanupToken
Timer --> UC_Notify
Timer --> UC_Widget

' ——— include ———
UC_AddFromSelection ..> UC_AddWord : <<include>>
UC_AddPhrase ..> UC_Grading : <<include>>
UC_Review ..> UC_ViewWord : <<extend>>
UC_ConfirmReview ..> UC_Review : <<include>>

note bottom of UC_Review
  "Ôn tập từ vựng" chỉ là **tab lọc phía client**
  trên dữ liệu Xem từ đã tải (next_review <= now).
  Không có luồng server riêng → không có act/seq riêng.
  Chỉ "Xác nhận ôn tập" mới gọi server (act-19/seq-19).
end note

note bottom of UC_AddByTopic
  AI xác nhận chủ đề hợp lệ (không → 400 nhập lại),
  lấy sổ từ hiện có của user làm danh sách loại trừ,
  sinh 10 từ mới (kèm nghĩa, phiên âm, từ loại, ví dụ)
  → ghi thẳng words + word_values của user, đồng thời
  bổ sung word_cache + word_cache_values (bỏ qua từ
  đã có trong cache). Không đi qua form "Thêm từ".
  Luồng: act-20 / seq-20.
end note

' ——— extend ———
UC_GenMeaning ..> UC_AddWord : <<extend>>
UC_ScanOCR ..> UC_Grading : <<extend>>

' ——— Actor AI đảm nhận (riêng "Thêm từ theo chủ đề" người dùng gọi trực tiếp, AI sinh dữ liệu) ———
UC_GenMeaning --> AI
UC_Grading --> AI
UC_AddByTopic --> AI

legend bottom
  |= Ký hiệu |= Ý nghĩa |
  |<#F8FBF8> Mũi tên liền | Người dùng / actor khởi tạo |
  |<#F8FBF8> Mũi tên đứt | «include» / «extend» |
  |<#FFF8E1> Ô vàng | AI tham gia sinh dữ liệu — *Sinh nghĩa từ*, *Chấm đoạn văn* user không gọi trực tiếp; *Thêm từ theo chủ đề* user bấm nút, AI sinh |
  |<#E3F2FD> Ô xanh | Tự động / chạy ngầm (client tự gọi hoặc server/thiết bị định kỳ) |
  |<#FFFDE7> AI đảm nhận | **Sinh nghĩa từ** (cache-first)\n**Chấm đoạn văn**: score, correctedText,\nerror, correction, explanation → lưu thẳng DB\n**Thêm từ theo chủ đề**: duyệt chủ đề + loại trừ\ntrùng → 10 từ vào words/word_values,\ncùng word_cache/word_cache_values |
endlegend
@enduml
