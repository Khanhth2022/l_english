@startuml act-11-them-doan-van
title Thêm đoạn văn
skinparam backgroundColor #FFFFFF
skinparam ActivityBackgroundColor #F4F6F7
skinparam ActivityBorderColor #546E7A
skinparam ActivityDiamondBackgroundColor #FFF9C4
skinparam ActivityDiamondBorderColor #F9A825
skinparam ArrowColor #37474F

start
:Người dùng gửi đoạn văn (kèm token);
:Kiểm tra token gửi lên;
if (Token hợp lệ?) then (không)
  #FFEBEE:Trả lỗi 401
  "Token không hợp lệ hoặc hết hạn";
else (có)
  :Gọi chức năng Chấm đoạn văn (<<include>>)
  → nhận score, correctedText,
  danh sách lỗi (incorrect, correction, explanation);
  if (Chấm thành công?) then (không)
    #FFEBEE:Trả lỗi 400 "Đoạn văn không hợp lệ"
    hoặc 502 "Dịch vụ AI tạm thời không khả dụng";
    note right
      Không lưu Phrase khi AI chưa chấm xong —
      score / correctedText / lỗi đều do AI sinh.
    end note
  else (có)
    :Lưu Phrase (score, correctedText)
    và GrammarErrors vào database;
    :Trả "Thêm đoạn văn thành công" + kết quả;
    :Hiển thị lên màn hình;
  endif
endif
stop
@enduml
