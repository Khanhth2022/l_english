@startuml act-19-xac-nhan-on-tap
title Xác nhận ôn tập (cập nhật SRS: review_count + next_review)
skinparam backgroundColor #FFFFFF
skinparam ActivityBackgroundColor #F4F6F7
skinparam ActivityBorderColor #546E7A
skinparam ActivityDiamondBackgroundColor #FFF9C4
skinparam ActivityDiamondBorderColor #F9A825
skinparam ArrowColor #37474F

start
:Người dùng chọn các từ đã ôn xong
rồi bấm "Xác nhận ôn tập";
:Gửi danh sách wordIds (kèm token);
:Kiểm tra token gửi lên;
if (Token hợp lệ?) then (không)
  #FFEBEE:Trả lỗi 401
  "Token không hợp lệ hoặc hết hạn";
else (có)
  :Lấy các Word theo wordIds
  của đúng user (WHERE user_id = ?);
  if (Mọi wordId đều thuộc user?) then (không)
    #FFEBEE:Trả lỗi 403
    "Không có quyền với từ không thuộc sở hữu";
  else (có)
    while (còn word trong danh sách?) is (còn)
      :review_count = review_count + 1;
      :Tính khoảng cách ôn kế tiếp theo review_count
      (giãn dần: 1, 2, 4, 7, 15, 30... ngày);
      :next_review = now() + khoảng cách;
      :updated_at = now();
    endwhile (hết)
    :Lưu (batch) các Word đã cập nhật vào DB;
    :Trả 200 + số từ đã xác nhận;
    :Cập nhật lại danh sách ôn tập (bớt các từ vừa ôn);
  endif
endif
stop
@enduml
