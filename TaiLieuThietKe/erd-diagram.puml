@startuml LEnglish_ERD
' ============================================================================
' LEnglish — Sơ đồ CSDL (ERD) suy ra từ các JPA Entity (xem class-diagram.puml).
' Ký hiệu crow's foot: || = một (bắt buộc) · o{ = nhiều (0..*).
' LƯU Ý render: luôn -charset UTF-8 (codepage máy = 1258 sẽ làm hỏng tiếng Việt).
'   java "-Dfile.encoding=UTF-8" -jar plantuml.jar -charset UTF-8 -tpng|-tsvg -o . erd-diagram.puml
' ============================================================================
!pragma layout smetana

title LEnglish — Sơ đồ cơ sở dữ liệu (ERD)
caption Suy ra từ JPA Entity. PK = khóa chính · FK = khóa ngoại · crow's foot thể hiện lực lượng quan hệ.

skinparam backgroundColor #FFFFFF
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 13
skinparam shadowing false
skinparam roundCorner 6
skinparam ArrowColor #455A64
skinparam ArrowThickness 1.3
skinparam nodesep 45
skinparam ranksep 65
skinparam entity {
  BackgroundColor #FFFFFF
  BorderColor #37474F
  FontStyle bold
}
skinparam note {
  BackgroundColor #FFFDE7
  BorderColor #F9A825
}

entity "users" as users {
  * id : BIGINT <<PK, AUTO_INCREMENT>>
  --
  * username : VARCHAR <<UNIQUE, NOT NULL>>
  * password : VARCHAR <<NOT NULL — BCrypt hash>>
}

entity "words" as words {
  * id : BIGINT <<PK, AUTO_INCREMENT>>
  --
  * user_id : BIGINT <<FK → users.id, NOT NULL>>
  english : VARCHAR <<NOT NULL>>
  level : VARCHAR <<enum A1..C2>>
  review_count : INT <<default 0>>
  next_review : DATETIME
  created_at : DATETIME
  updated_at : DATETIME
  --
  UNIQUE (user_id, english)
}

entity "word_values" as wv {
  * id : BIGINT <<PK, AUTO_INCREMENT>>
  --
  * word_id : BIGINT <<FK → words.id, NOT NULL>>
  vietnamese : VARCHAR <<nghĩa tiếng Việt>>
  example : VARCHAR <<câu ví dụ>>
  example_translation : VARCHAR <<dịch câu ví dụ>>
  pronunciation : VARCHAR <<phiên âm IPA>>
  part_of_speech : VARCHAR <<enum PartOfSpeech>>
}

entity "word_cache" as wc {
  * id : BIGINT <<PK, AUTO_INCREMENT>>
  --
  english : VARCHAR <<UNIQUE>>
  level : VARCHAR <<enum A1..C2>>
  created_at : DATETIME
  updated_at : DATETIME
}

entity "word_cache_values" as wcv {
  * id : BIGINT <<PK, AUTO_INCREMENT>>
  --
  * word_cache_id : BIGINT <<FK → word_cache.id, NOT NULL>>
  vietnamese : VARCHAR <<nghĩa tiếng Việt>>
  example : VARCHAR <<câu ví dụ>>
  example_translation : VARCHAR <<dịch câu ví dụ>>
  pronunciation : VARCHAR <<phiên âm IPA>>
  part_of_speech : VARCHAR <<enum PartOfSpeech>>
}

entity "phrases" as phrases {
  * id : BIGINT <<PK, AUTO_INCREMENT>>
  --
  * user_id : BIGINT <<FK → users.id, NOT NULL>>
  text : VARCHAR <<câu gốc>>
  corrected_text : VARCHAR <<câu đã sửa>>
  score : INT <<CHECK 0..10>>
  created_at : DATETIME
  updated_at : DATETIME
}

entity "grammar_errors" as ge {
  * id : BIGINT <<PK, AUTO_INCREMENT>>
  --
  * phrase_id : BIGINT <<FK → phrases.id, NOT NULL>>
  incorrect : VARCHAR <<cụm sai>>
  correction : VARCHAR <<cụm đúng>>
  explanation : VARCHAR <<giải thích (VN)>>
}

entity "refresh_tokens" as rt {
  * id : BIGINT <<PK, AUTO_INCREMENT>>
  --
  * user_id : BIGINT <<FK → users.id, NOT NULL>>
  token : VARCHAR <<UNIQUE, NOT NULL — chuỗi token>>
  expiry_date : DATETIME <<NOT NULL>>
  created_at : DATETIME
}

' ===================== Quan hệ (crow's foot) =====================
users ||--o{ words          : sở hữu
users ||--o{ phrases        : sở hữu
users ||--o{ rt            : sở hữu
phrases ||--o{ ge           : chứa (ON DELETE CASCADE)
words ||--o{ wv             : chứa (ON DELETE CASCADE)
wc    ||--o{ wcv            : chứa (ON DELETE CASCADE)

note bottom of wcv
  word_cache → word_cache_values (1–n).
  word_values và word_cache_values có CÙNG bộ cột nghiệp vụ
  nhưng KHÁC vai trò: word_values là bản sao thuộc sổ của
  từng user, word_cache_values là bản dùng chung toàn hệ thống.
  Luồng Sinh nghĩa từ (AI) ghi word_cache -> word_cache_values;
  luồng Thêm từ mới copy từ cache sang word_values (seq-06 / seq-09).
end note

note bottom of wv
  word_values KHÔNG có user_id: quyền sở hữu suy ra qua
  words.user_id (word_values.word_id → words.id, ON DELETE CASCADE).
end note

@enduml
